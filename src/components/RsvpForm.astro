---
interface Props {
  closesIso: string;
  thanksYesTitle: string;
  thanksYes: string;
  thanksNoTitle: string;
  thanksNo: string;
  thanksDoneYes: string;
  thanksDoneNo: string;
  mapsUrl: string;
}

const { closesIso, thanksYesTitle, thanksYes, thanksNoTitle, thanksNo, thanksDoneYes, thanksDoneNo, mapsUrl } =
  Astro.props;
---

<div
  class="card"
  data-rsvp
  data-closes={closesIso}
  data-thanks-yes-title={thanksYesTitle}
  data-thanks-yes={thanksYes}
  data-thanks-no-title={thanksNoTitle}
  data-thanks-no={thanksNo}
  data-thanks-done-yes={thanksDoneYes}
  data-thanks-done-no={thanksDoneNo}
>
  <form class="form" data-form>
    <div class="form-fields" data-fields>
      <label class="label">
        ¿Cómo te llamás?
        <input class="input" name="nombre" type="text" required maxlength="80" autocomplete="name" />
      </label>

      <fieldset class="label">
        <legend>¿Nos vemos ese día?</legend>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="asiste" value="si" required />
            Sí, voy
          </label>
          <label class="choice">
            <input type="radio" name="asiste" value="no" />
            No voy a poder
          </label>
        </div>
      </fieldset>

      <label class="label" data-cantidad hidden>
        ¿Cuántos van a venir, contándote a vos?
        <input class="input" name="cantidad" type="number" min="1" max="20" value="1" disabled />
      </label>

      <label class="label">
        ¿Querés dejarnos un recadito? <span class="optional">(opcional)</span>
        <textarea class="textarea" name="comentario" maxlength="280" placeholder="Alergias, si llegan un ratito tarde, un beso…"></textarea>
      </label>
    </div>

    <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" />

    <button class="btn btn-leaf" type="submit">¡Cuenten conmigo!</button>
    <p class="status" data-status hidden aria-live="polite"></p>
  </form>

  <div class="thanks" data-thanks hidden>
    <div class="thanks-burst" data-burst aria-hidden="true">
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
    </div>
    <h2 data-thanks-title></h2>
    <p data-thanks-text></p>
    <p class="thanks-recap" data-recap></p>
    <p class="thanks-done" data-thanks-done></p>
    <div class="thanks-actions" data-yes-actions hidden>
      <a class="btn btn-leaf" href={mapsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
    </div>
    <p class="thanks-note">Si cambia el plan, escríbanle a Selena o Martín.</p>
  </div>

  <p class="status" data-closed hidden>
    Ya cerramos las confirmaciones por acá. Si cambió algo, escríbanle a Selena o Martín: los quieren igual.
  </p>
</div>

<script>
  import gsap from "gsap";

  const STORAGE_KEY = "giuliano-rsvp";

  const root = document.querySelector("[data-rsvp]");
  if (root instanceof HTMLElement) {
    const form = root.querySelector("[data-form]");
    const thanks = root.querySelector("[data-thanks]");
    const thanksTitle = root.querySelector("[data-thanks-title]");
    const thanksText = root.querySelector("[data-thanks-text]");
    const recap = root.querySelector("[data-recap]");
    const thanksDone = root.querySelector("[data-thanks-done]");
    const yesActions = root.querySelector("[data-yes-actions]");
    const closed = root.querySelector("[data-closed]");
    const status = root.querySelector("[data-status]");
    const cantidadWrap = root.querySelector("[data-cantidad]");
    const cantidadInput = root.querySelector('input[name="cantidad"]');
    const submit = root.querySelector('button[type="submit"]');
    const fields = root.querySelector("[data-fields]");
    const section = root.closest("section");

    const lockForm = (busy: boolean) => {
      if (form instanceof HTMLFormElement) {
        form.classList.toggle("is-sending", busy);
        form.setAttribute("aria-busy", busy ? "true" : "false");
      }
      if (fields instanceof HTMLElement) {
        fields.inert = busy;
      }
    };

    const setPageState = (asiste: string) => {
      document.documentElement.dataset.rsvp = asiste === "si" ? "si" : "no";
    };

    const hideInviteCopy = () => {
      section?.querySelector(".section-title")?.setAttribute("hidden", "");
      section?.querySelector(".lead")?.setAttribute("hidden", "");
    };

    const showThanks = (asiste: string, nombre: string, cantidad: number, animate = false) => {
      const going = asiste === "si";
      form?.setAttribute("hidden", "");
      thanks?.removeAttribute("hidden");
      hideInviteCopy();
      setPageState(asiste);

      if (thanksTitle) {
        thanksTitle.textContent = going
          ? (root.dataset.thanksYesTitle ?? "")
          : (root.dataset.thanksNoTitle ?? "");
      }
      if (thanksText) {
        thanksText.textContent = going ? (root.dataset.thanksYes ?? "") : (root.dataset.thanksNo ?? "");
      }
      if (recap) {
        recap.textContent = going
          ? `Anotamos a ${nombre}${cantidad > 1 ? `, ${cantidad} personas` : ""}.`
          : `Anotamos que ${nombre} no va a poder estar.`;
      }
      if (thanksDone) {
        thanksDone.textContent = going
          ? (root.dataset.thanksDoneYes ?? "")
          : (root.dataset.thanksDoneNo ?? "");
      }
      if (going) yesActions?.removeAttribute("hidden");
      else yesActions?.setAttribute("hidden", "");

      thanks?.scrollIntoView({ behavior: "smooth", block: "center" });

      if (animate && thanks instanceof HTMLElement) {
        gsap.set(thanks, { opacity: 0 });
        requestAnimationFrame(() => playConfirm(thanks, going));
      }
    };

    const playConfirm = (card: HTMLElement, going: boolean) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const burst = card.querySelectorAll("[data-burst] span");
      gsap.fromTo(
        card,
        { opacity: 0, y: 18, scale: 0.97 },
        { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: "power2.out" },
      );

      if (!going || burst.length === 0) return;

      gsap.fromTo(
        burst,
        { opacity: 0, scale: 0, x: 0, y: 0 },
        {
          opacity: 1,
          scale: 1,
          x: () => gsap.utils.random(-52, 52),
          y: () => gsap.utils.random(-46, -12),
          rotation: () => gsap.utils.random(-40, 40),
          duration: 0.7,
          stagger: 0.035,
          ease: "power2.out",
        },
      );
      gsap.to(burst, { opacity: 0, duration: 0.45, delay: 0.75, ease: "power1.in" });
    };

    const closes = new Date(root.dataset.closes ?? "").getTime();
    const saved = sessionStorage.getItem(STORAGE_KEY);

    if (saved) {
      try {
        const prev = JSON.parse(saved) as { asiste: string; nombre: string; cantidad: number };
        showThanks(prev.asiste, prev.nombre, prev.cantidad);
      } catch {
        sessionStorage.removeItem(STORAGE_KEY);
      }
    } else if (Date.now() > closes) {
      form?.setAttribute("hidden", "");
      closed?.removeAttribute("hidden");
    }

    const syncAttendance = () => {
      const going = root.querySelector('input[name="asiste"]:checked');
      const isYes = going instanceof HTMLInputElement && going.value === "si";
      const isNo = going instanceof HTMLInputElement && going.value === "no";

      if (cantidadWrap instanceof HTMLElement) {
        cantidadWrap.hidden = !isYes;
      }
      if (cantidadInput instanceof HTMLInputElement) {
        cantidadInput.disabled = !isYes;
        cantidadInput.required = isYes;
        if (isNo) cantidadInput.value = "0";
        else if (isYes && (cantidadInput.value === "0" || cantidadInput.value === "")) {
          cantidadInput.value = "1";
        }
      }
      if (submit instanceof HTMLButtonElement && !submit.disabled) {
        submit.textContent = isNo ? "Avisar que no voy a poder" : "¡Cuenten conmigo!";
      }
    };

    root.querySelectorAll('input[name="asiste"]').forEach((radio) => {
      radio.addEventListener("change", syncAttendance);
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      if (!(submit instanceof HTMLButtonElement)) return;
      if (!(status instanceof HTMLElement)) return;

      const payload = new FormData(form);
      const asiste = String(payload.get("asiste") ?? "");
      const nombre = String(payload.get("nombre") ?? "").trim();
      const cantidad = Number(payload.get("cantidad") ?? 0);

      status.hidden = true;
      lockForm(true);
      submit.disabled = true;
      submit.textContent = "Un segundo…";

      try {
        const res = await fetch("/api/rsvp", {
          method: "POST",
          body: payload,
        });
        const data = (await res.json()) as { ok?: boolean; error?: string };
        if (!res.ok || !data.ok) {
          throw new Error(data.error ?? "No se pudo guardar");
        }

        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ asiste, nombre, cantidad }));
        showThanks(asiste, nombre, cantidad, true);
      } catch {
        lockForm(false);
        status.hidden = false;
        status.className = "status err";
        status.textContent = "Uy, no se pudo enviar. ¿Probamos de nuevo en un ratito?";
        submit.disabled = false;
        submit.textContent =
          String(payload.get("asiste")) === "no" ? "Avisar que no voy a poder" : "¡Cuenten conmigo!";
      }
    });
  }
</script>
